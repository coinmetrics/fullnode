+    uint256 hash_replacement = tx_replacement.GetHash().ToUint256();
+    LogDebug(BCLog::ZMQ, "zmq: Publish mempoolreplaced %s by %s\n", hash_replaced.GetHex(), hash_replacement.GetHex());
